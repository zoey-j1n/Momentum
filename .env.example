# Postgres (docker-compose.yml). Host port 5433 because 5432 is taken by another project on this machine.
DATABASE_URL=postgresql://momentum:momentum@localhost:5433/momentum

# Slack
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-5-5
# low | medium | high. Haiku's default is medium; extraction rarely needs more.
ANALYSIS_EFFORT=medium
# Output cap per analysis (decision: per-request caps, DESIGN 4.9)
ANALYSIS_MAX_TOKENS=4096

NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Test database for Milestone 2+. Same container, separate database named momentum_test.
# Create it once: docker compose exec db psql -U momentum -d momentum -c "CREATE DATABASE momentum_test"
# Apply migrations to it: npm run db:test:migrate
# DATABASE_URL for tests lives in .env.test

# Worker (Milestone 4)
# WORKER_POLL_MS=1000          # how often an idle worker checks the Job table
# JOB_BACKOFF_BASE_MS=1000     # first retry delay; doubles each attempt, capped at 5 minutes
