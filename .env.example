# Postgres (docker-compose.yml). Host port 5433 because 5432 is taken by another project on this machine.
DATABASE_URL=postgresql://momentum:momentum@localhost:5433/momentum
# Production only (Neon): the unpooled connection string, used by `prisma migrate deploy` at build time.
# DIRECT_DATABASE_URL=postgresql://...

# Slack. Load slack/manifest.json at api.slack.com/apps > Create New App > From a manifest, install it,
# then copy both values from the app's Basic Information (signing secret) and Install App (bot token) pages.
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
# SLACK_USE_FAKE_READER=1       # worker reads the built-in sample thread instead of Slack (enqueue-sample, crash test)

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-haiku-5-5
# low | medium | high. Haiku's default is medium; extraction rarely needs more.
ANALYSIS_EFFORT=medium
# Output cap per analysis (decision: per-request caps, DESIGN 4.9)
ANALYSIS_MAX_TOKENS=16384

NEXT_PUBLIC_BASE_URL=http://localhost:3000

SLACK_CLIENT_SECRET=...
SLACK_TEAM_ID=T...
SESSION_SECRET=...
TOKEN_ENCRYPTION_KEY=...
# Per-user rate limit (DESIGN 4.9 layer 3): analyses one person may request per hour. Default 10.
# ANALYSES_PER_USER_PER_HOUR=10
