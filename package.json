{
  "name": "momentum",
  "version": "1.0.0",
  "description": "Slack command center with AI-powered actions",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "bolt": "node --env-file=.env -r tsx/cjs bolt/app.ts",
    "worker": "tsx worker/index.ts",
    "tunnel": "cloudflared tunnel --url http://localhost:3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:test:migrate": "DATABASE_URL=postgresql://momentum:momentum@localhost:5433/momentum_test prisma migrate deploy"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khuhub/Momentum.git"
  },
  "license": "ISC",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@notionhq/client": "^5.13.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@slack/bolt": "^4.6.0",
    "@slack/web-api": "^7.19.0",
    "dotenv": "^18.0.9",
    "jose": "^6.2.15",
    "next": "^16.1.6",
    "openai": "^6.29.0",
    "pg": "^8.23.1",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.14",
    "postcss": "^8.5.8",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
